<Window x:Class="Lab07.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumbre Biblioteca" Width="1440" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Ivory}" PreviewKeyDown="OnEscape">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Forest}">
            <DockPanel Margin="22,27,18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="7,0,0,45">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Ochre}">
                            <TextBlock Text="✦" Foreground="{StaticResource Forest}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="lumbre" Foreground="White" FontSize="23" FontWeight="SemiBold" FontFamily="Georgia" />
                            <TextBlock Text="BIBLIOTECA" Foreground="#BBD0C1" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="ESPACIO DE TRABAJO" Foreground="#AAC4B5" FontSize="10" Margin="11,0,0,14" FontWeight="SemiBold" />
                    <ToggleButton Content="⌂     Inicio" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Inicio" Style="{StaticResource NavButton}" />
                    <ToggleButton Content="▤     Libros" IsChecked="{Binding IsBooks, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Libros" Style="{StaticResource NavButton}" />
                    <ToggleButton Content="♙     Socios" IsChecked="{Binding IsMembers, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Socios" Style="{StaticResource NavButton}" />
                    <ToggleButton Content="↗     Préstamos" IsChecked="{Binding IsLoans, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Préstamos" Style="{StaticResource NavButton}" />
                    <ToggleButton Content="↘     Devoluciones" IsChecked="{Binding IsReturns, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Devoluciones" Style="{StaticResource NavButton}" />
                    <ToggleButton Content="▥     Reportes" IsChecked="{Binding IsReports, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Reportes" Style="{StaticResource NavButton}" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="#41695C" BorderThickness="0,1,0,0" Padding="10,17,0,0">
                    <TextBlock Text="Una historia a la vez." Foreground="#BBD0C1" FontFamily="Georgia" FontStyle="Italic" FontSize="13" />
                </Border>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="98" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="38,19,38,15">
                <StackPanel>
                    <TextBlock Text="{Binding Section}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" />
                </StackPanel>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding Current}" Margin="30,26,30,28" />
        </Grid>
    </Grid>
</Window>

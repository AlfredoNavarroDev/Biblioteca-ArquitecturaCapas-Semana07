<UserControl x:Class="Lab07.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,19"><TextBlock Text="Historia de préstamos" Style="{StaticResource PageTitle}" /><TextBlock Text="Consulta lo registrado durante un intervalo de fechas." Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="16" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><StackPanel Margin="0,0,15,0"><TextBlock Text="Desde" Margin="0,0,0,6" /><DatePicker SelectedDate="{Binding From}" Width="165" /></StackPanel><StackPanel Margin="0,0,15,0"><TextBlock Text="Hasta" Margin="0,0,0,6" /><DatePicker SelectedDate="{Binding To}" Width="165" /></StackPanel><Button Content="Consultar" Style="{StaticResource PrimaryButton}" Command="{Binding ConsultCommand}" VerticalAlignment="Bottom" /></StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource Surface}" Padding="1"><DataGrid ItemsSource="{Binding Rows}" MinHeight="300"><DataGrid.Columns><DataGridTextColumn Header="SOCIO" Binding="{Binding Member}" Width="*" /><DataGridTextColumn Header="LIBRO" Binding="{Binding Book}" Width="2*" /><DataGridTextColumn Header="PRÉSTAMO" Binding="{Binding DateText}" Width="112" /><DataGridTextColumn Header="LÍMITE" Binding="{Binding DueText}" Width="112" /><DataGridTextColumn Header="ESTADO" Binding="{Binding StoredStatus}" Width="95" /><DataGridTextColumn Header="CONDICIÓN" Binding="{Binding Condition}" Width="95" /></DataGrid.Columns></DataGrid></Border>
        <StackPanel Grid.Row="3" Margin="0,13,0,0"><TextBlock Text="La fecha final incluye todo el día seleccionado." Style="{StaticResource Caption}" /><TextBlock Text="No hay préstamos en este intervalo." Visibility="{Binding Rows.Count, Converter={StaticResource EmptyCountVisibility}}" Style="{StaticResource Caption}" Margin="0,5,0,0" /><TextBlock Text="{Binding Error}" Style="{StaticResource StatusError}" Margin="0,5,0,0" /><TextBlock Text="Cargando…" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Caption}" /></StackPanel>
    </Grid>
</UserControl>

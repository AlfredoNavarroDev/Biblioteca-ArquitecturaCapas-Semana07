<UserControl x:Class="Lab07.Views.ReturnsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,19"><TextBlock Text="Registrar una devolución" Style="{StaticResource PageTitle}" /><TextBlock Text="Devuelve un libro sin cerrar los demás del préstamo." Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="15" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por socio, DNI o número de préstamo" Margin="0,0,12,0" /><Button Grid.Column="1" Content="Buscar pendientes" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" /></Grid></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Surface}" Padding="17" Margin="0,0,15,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Préstamos encontrados" Style="{StaticResource SectionTitle}" Margin="0,0,0,13" /><ListBox ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedLoan}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding SocioNombre}" FontWeight="SemiBold" /><TextBlock Text="{Binding PrestamoId, StringFormat=Préstamo #{0}}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding FechaLimite, StringFormat=Hasta {0:dd MMM yyyy}}" Style="{StaticResource Caption}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Surface}" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Libros del préstamo" Style="{StaticResource SectionTitle}" /><TextBlock Text="Selecciona un libro pendiente. La multa se calcula en Negocio al devolver." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,14" /></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding LastFine}" Foreground="{StaticResource Forest}" FontWeight="SemiBold" Margin="0,13,0,9" /><Button Content="Registrar devolución del libro seleccionado" Style="{StaticResource PrimaryButton}" Command="{Binding ReturnCommand}" /></StackPanel><DataGrid ItemsSource="{Binding Details}" SelectedItem="{Binding SelectedDetail}"><DataGrid.Columns><DataGridTextColumn Header="LIBRO" Binding="{Binding Title}" Width="*" /><DataGridTextColumn Header="FECHA LÍMITE" Binding="{Binding DueText}" Width="118" /><DataGridTextColumn Header="RETRASO" Binding="{Binding DelayText}" Width="100" /><DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="128" /><DataGridTextColumn Header="MULTA" Binding="{Binding FineText}" Width="125" /></DataGrid.Columns></DataGrid></DockPanel></Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,13,0,0"><TextBlock Text="No hay préstamos pendientes para esta búsqueda." Visibility="{Binding Matches.Count, Converter={StaticResource EmptyCountVisibility}}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Error}" Style="{StaticResource StatusError}" /><TextBlock Text="{Binding Notice}" Foreground="{StaticResource Forest}" /><TextBlock Text="Cargando…" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Caption}" /></StackPanel>
    </Grid>
</UserControl>

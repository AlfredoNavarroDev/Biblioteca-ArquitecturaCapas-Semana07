<UserControl x:Class="Lab07.Views.LoansView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,19"><TextBlock Text="Un nuevo préstamo" Style="{StaticResource PageTitle}" /><TextBlock Text="Selecciona un socio, agrega libros y confirma la operación completa." Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,16,0">
                <Border Style="{StaticResource Surface}" Padding="21" Margin="0,0,0,15"><StackPanel>
                    <TextBlock Text="01  Seleccionar socio" Style="{StaticResource SectionTitle}" /><TextBlock Text="Solo socios activos" Style="{StaticResource Caption}" Margin="0,4,0,12" />
                    <TextBox Text="{Binding MemberSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar socio por nombre o DNI" Margin="0,0,0,9" />
                    <DataGrid ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" Height="164"><DataGrid.Columns><DataGridTextColumn Header="SOCIO" Binding="{Binding Nombre}" Width="*" /><DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="115" /></DataGrid.Columns></DataGrid>
                    <TextBlock Text="{Binding CapacityText}" Foreground="{StaticResource Forest}" Margin="0,11,0,0" FontWeight="SemiBold" />
                </StackPanel></Border>
                <Border Style="{StaticResource Surface}" Padding="21"><StackPanel>
                    <TextBlock Text="02  Buscar y agregar libros" Style="{StaticResource SectionTitle}" /><TextBlock Text="Solo libros activos con ejemplares disponibles" Style="{StaticResource Caption}" Margin="0,4,0,12" />
                    <TextBox Text="{Binding BookSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar libro por título o autor" Margin="0,0,0,9" />
                    <DataGrid ItemsSource="{Binding Books}" Height="225"><DataGrid.Columns><DataGridTextColumn Header="LIBRO" Binding="{Binding Titulo}" Width="2*" /><DataGridTextColumn Header="DISP." Binding="{Binding Ejemplares}" Width="65" /><DataGridTemplateColumn Width="86"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Agregar" Padding="7,4" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
                </StackPanel></Border>
            </StackPanel></ScrollViewer>
            <Border Grid.Column="1" Style="{StaticResource Surface}" Padding="23"><DockPanel>
                <StackPanel DockPanel.Dock="Top"><TextBlock Text="03  Revisar y confirmar" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource Forest}" FontWeight="SemiBold" Margin="0,8,0,18" /><Separator /><TextBlock Text="Libros seleccionados" Margin="0,17,0,9" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SelectedBooks}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Quitar" Padding="8,4" Margin="8,0,0,0" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Separator Margin="0,17,0,16" /><TextBlock Text="Fecha límite" FontWeight="SemiBold" /><TextBlock Text="{Binding DueText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="Máximo 3 pendientes por socio. Negocio valida disponibilidad y estado al confirmar." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,20,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom"><Button Content="Confirmar préstamo" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}" Margin="0,15,0,0" /></StackPanel>
            </DockPanel></Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,13,0,0"><TextBlock Text="{Binding Error}" Style="{StaticResource StatusError}" /><TextBlock Text="{Binding Notice}" Foreground="{StaticResource Forest}" /><TextBlock Text="Cargando…" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Caption}" /></StackPanel>
    </Grid>
</UserControl>

<Application x:Class="Lab07.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lab07"
             xmlns:vm="clr-namespace:Lab07.ViewModels"
             xmlns:views="clr-namespace:Lab07.Views"
             xmlns:services="clr-namespace:Lab07.Services"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <services:EmptyCountVisibilityConverter x:Key="EmptyCountVisibility" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BooksViewModel}"><views:BooksView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MembersViewModel}"><views:MembersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoansViewModel}"><views:LoansView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReturnsViewModel}"><views:ReturnsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
